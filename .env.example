# Copy to .env for local development. Every value is optional.

# Postgres (psycopg 3). Leave empty to use a local SQLite file.
# DATABASE_URL=postgresql://pantry:pantry@localhost:5432/pantry

# Signs the session cookie. Set a long random value in production.
# SECRET_KEY=change-me

# Enables Claude for "What can I cook?" and recipe import.
# Without it the built-in matcher and parser answer instead.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Seed the demo account and show the "demo resets" banner.
# DEMO_MODE=false
